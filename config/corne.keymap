#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

#define MOUSE 4
#define MOUSE_SLOW 5
#define MOUSE_FAST 6

// Hold A / D on the mouse layer to speed up / slow down the cursor (warpd's
// accelerator / decelerator keys).
&mmv_input_listener {
    slow {
        layers = <MOUSE_SLOW>;
        input-processors = <&zip_xy_scaler 1 4>;
    };
    fast {
        layers = <MOUSE_FAST>;
        input-processors = <&zip_xy_scaler 3 1>;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB       &kp Q  &kp W  &kp E             &kp R  &kp T           &kp Y      &kp U  &kp I                    &kp O    &kp P     &kp BSPC
&kp ESC       &kp A  &kp S  &kp D             &kp F  &kp G           &kp H      &kp J  &kp K                    &kp L    &kp SEMI  &kp SQT
&kp LEFT_ALT  &kp Z  &kp X  &kp C             &kp V  &kp B           &kp N      &kp M  &kp COMMA                &kp DOT  &kp FSLH  &mt LEFT_SHIFT ENTER
                            &kp LEFT_CONTROL  &mo 1  &kp LEFT_SHIFT  &kp SPACE  &mo 2  &mt RIGHT_GUI RG(SPACE)
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp GRAVE  &kp N1      &kp N2      &kp N3      &kp N4  &kp N5          &kp N6    &kp N7             &kp N8         &kp N9     &kp N0            &kp BSPC
&kp CAPS   &trans      &trans      &trans      &trans  &trans          &kp LEFT  &kp DOWN           &kp UP         &kp RIGHT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans     &kp C_MUTE  &kp C_PREV  &kp C_NEXT  &trans  &trans          &trans    &trans             &kp MINUS      &kp EQUAL  &kp BACKSLASH     &mt LEFT_SHIFT ENTER
                                   &trans      &trans  &kp LEFT_SHIFT  &mo 3     &kp RIGHT_CONTROL  &kp RIGHT_GUI
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TILDE  &kp EXCL  &kp AT             &kp HASH         &kp DLLR      &kp PRCNT       &kp CARET  &kp AMPS  &kp ASTERISK   &kp LPAR   &kp RPAR        &trans
&trans     &trans    &kp LA(LG(X))      &tog MOUSE       &trans        &kp LA(LG(G))   &kp LEFT   &kp DOWN  &kp UP         &kp RIGHT  &kp LEFT_BRACE  &kp RIGHT_BRACE
&trans     &kp C_PP  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans        &trans          &trans     &trans    &kp UNDER      &kp PLUS   &kp PIPE        &trans
                                        &kp LCTRL        &kp LEFT_GUI  &kp LEFT_SHIFT  &trans     &trans    &kp RIGHT_GUI
            >;
        };

        Layer__3 {
            bindings = <
&kp F12       &kp F1      &kp F2        &kp F3        &kp F4        &kp F5        &kp F6  &kp F7            &kp F8             &kp F9  &kp F10  &kp F11
&bt BT_SEL 0  &bt BT_CLR  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &ext_power EP_ON  &ext_power EP_OFF  &trans  &trans   &trans
&trans        &trans      &trans        &trans        &trans        &trans        &trans  &trans            &trans             &trans  &trans   &trans
                                        &trans        &trans        &trans        &trans  &trans            &trans
            >;
        };

        mouse_layer {
            // Toggled by raise + D (replaces warpd's normal mode; raise + S / G still fire
            // warpd's hint / grid). Same keys as warpd's defaults.
            // -----------------------------------------------------------------------------------------
            // |      |     |     | SDN | SUP |     |   |     |     |     |     |     |      |
            // | EXIT | FST |     | SLW |     |     |   |  ←  |  ↓  |  ↑  |  →  |     |      |
            // | ALT  |     |     |     | LCK |     |   |     | LCK | MCK | RCK |     | SHFT |
            //                    | CTRL|     | SHFT|   | SPC | RSE | GUI |
            // V is a held left click, so hold V + hjkl to drag. Modifiers stay live for cmd-click etc.

            bindings = <
&none        &none         &none  &msc SCRL_DOWN   &msc SCRL_UP  &none           &none            &none         &none          &none          &none  &none
&tog MOUSE   &mo MOUSE_FAST  &none  &mo MOUSE_SLOW   &none         &none           &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_UP   &mmv MOVE_RIGHT  &none  &none
&trans       &none         &none  &none            &mkp LCLK     &none           &none            &mkp LCLK     &mkp MCLK      &mkp RCLK      &none  &trans
                                  &trans           &trans        &trans          &trans           &trans        &trans
            >;
        };

        mouse_slow_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        mouse_fast_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};


&kscan0 {
    debounce-press-ms = <12>;
    debounce-release-ms = <10>;
    debounce-scan-period-ms = <5>;
};
